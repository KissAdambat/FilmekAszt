<Window x:Class="Filmek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Filmek"
        mc:Ignorable="d"
        Title="Filmek" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,25,0,0">
            <Button x:Name="btnBetoltes" Content="Filmek betöltése" Height="28" Margin="0,0,0,13"
                    Click="btnBetoltes_Click"/>
            <Button x:Name="btnDarab" Content="Hány film van?" Height="28" Margin="0,0,0,13"
                    Click="btnDarab_Click"/>
            <Button x:Name="btnLeghosszabb" Content="Leghosszabb film?" Height="28" Margin="0,0,0,13"
                    Click="btnLeghosszabb_Click"/>
            <Button x:Name="btnAtlag" Content="Átlag értékelés" Height="28" Margin="0,0,0,13"
                    Click="btnAtlag_Click"/>
            <Button x:Name="btnSciFi" Content="Csak sci-fi" Height="28" Margin="0,0,0,13"
                    Click="btnSciFi_Click"/>
            <Button x:Name="btnCimek" Content="Csak címek" Height="28" Margin="0,0,0,13"
                    Click="btnCimek_Click"/>
            <Button x:Name="btnRendezes" Content="Rendezés cím szerint" Height="28" Margin="0,0,0,13"
                    Click="btnRendezes_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgFilmek" Grid.Column="2" Margin="35,20,15,20"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="Black" VerticalGridLinesBrush="Black"
                  SelectionChanged="dgFilmek_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cim" Binding="{Binding Cim}" Width="*"/>
                <DataGridTextColumn Header="Mufaj" Binding="{Binding Mufaj}" Width="*"/>
                <DataGridTextColumn Header="Hossz" Binding="{Binding Hossz}" Width="*"/>
                <DataGridTextColumn Header="Ertekeles" Binding="{Binding Ertekeles}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
